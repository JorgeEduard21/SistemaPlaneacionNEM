<Application x:Class="Frontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Frontend.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invertir="True"/>
        <conv:EqualityToVisibilityConverter x:Key="EqToVis"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="InverseNullOrEmptyToVis" Invertir="True"/>
        <conv:EqualityToBoolConverter x:Key="EqToBool"/>
        <conv:PasoEstadoConverter x:Key="PasoEstado"/>
        <SolidColorBrush x:Key="ColorExito" Color="#4E7D6E"/>

        <!-- Fuente con respaldo de emojis: así los iconos (📝 ⚙️ 📂 👥 🔑 ...) siempre se dibujan -->
        <FontFamily x:Key="FuenteApp">Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>

        <!-- Paleta de Colores Base -->
        <SolidColorBrush x:Key="ColorFondo" Color="#FDF8F2"/>
        <SolidColorBrush x:Key="ColorPrimario" Color="#C25A38"/>
        <SolidColorBrush x:Key="ColorPrimarioHover" Color="#A94A2C"/>
        <SolidColorBrush x:Key="ColorPrimarioSuave" Color="#FFF2EB"/>
        <SolidColorBrush x:Key="ColorTextoPrincipal" Color="#334155"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#E5D8C5"/>
        <LinearGradientBrush x:Key="GradientePrimario" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D9714B" Offset="0"/>
            <GradientStop Color="#B24E2F" Offset="1"/>
        </LinearGradientBrush>

        <!-- Fuente global para ventanas y controles de usuario -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource FuenteApp}"/>
        </Style>
        <Style TargetType="UserControl">
            <Setter Property="FontFamily" Value="{StaticResource FuenteApp}"/>
        </Style>

        <!-- Estilo Tarjeta Contenedora -->
        <Style x:Key="TarjetaFigma" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#B9A58C" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestañas segmentadas (selector de subsecciones) -->
        <Style x:Key="TabSegmento" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#6B5E50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#E9DFD2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="Fondo" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#8C7358" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compatibilidad: alias con nombre incorrecto usado en XAML (TarjetaFiga) -->
        <!-- Se añade alias basado en TarjetaFigma para evitar XamlParseException si hay referencias con typo -->
        <Style x:Key="TarjetaFiga" TargetType="Border" BasedOn="{StaticResource TarjetaFigma}" />

        <!-- Estilo para Chips (Grados y Entornos) -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorPrimarioSuave}"/>
                                <Setter Property="BorderBrush" Value="#E8A88E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Estilo exclusivo para RadioButtons (Selección Única) -->
        <Style x:Key="ChipRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorPrimarioSuave}"/>
                                <Setter Property="BorderBrush" Value="#E8A88E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Estilo Inputs de Texto con placeholder (Tag) -->
        <Style x:Key="TextBoxElegante" TargetType="TextBox">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FCFCFC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="Margin" Value="0,5,0,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Borde" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B8"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           Margin="2,0,0,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              Focusable="False" 
                                              HorizontalScrollBarVisibility="Hidden" 
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#D4A373"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="Borde" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Estilo Botón Principal Naranja -->
        <Style x:Key="BotonNaranja" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{StaticResource GradientePrimario}" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#C25A38" Opacity="0.30"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Google Docs (Azul / Verde Salvia Elegante) -->
        <Style x:Key="BotonGoogleDocs" TargetType="Button">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#1A73E8" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Secundario Gris -->
        <Style x:Key="BotonGris" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón del Stepper (Asistente) -->
        <Style x:Key="BotonPasoStepper" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Contenedor" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Contenedor" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tarjetas VARK -->
        <Style x:Key="TarjetaVARK" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FCFCFC"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" Padding="0,25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FFF2EB"/>
                                <!-- Fondo sutil naranja -->
                                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Estilo Tarjeta Descriptiva (Metodologías) -->
        <Style x:Key="TarjetaMetodologia" TargetType="RadioButton">
            <Setter Property="Background" Value="#FCFCFC"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#D4A373"/>
                                <Setter TargetName="Borde" Property="Background" Value="#FFFDF9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#FFF2EB"/>
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tarjeta Instrumentos (Limpia, elegante, con checkmark y sin oscurecerse) -->
        <Style x:Key="TarjetaInstrumento" TargetType="RadioButton">
            <Setter Property="Background" Value="#FCFCFC"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <!-- Checkmark dentro de un círculo elegante a la derecha -->
                                <Border x:Name="CheckCirculo" Grid.Column="1" Width="26" Height="26" CornerRadius="13" 
                                        Background="{StaticResource ColorPrimario}" VerticalAlignment="Center" Margin="15,0,5,0" Visibility="Collapsed">
                                    <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#D4A373"/>
                                <Setter TargetName="Borde" Property="Background" Value="#FFFDF9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#FFF5EE"/>
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="CheckCirculo" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tarjeta Materiales (con radio/checkbox visual indicador circular a la derecha) -->
        <Style x:Key="TarjetaMaterial" TargetType="CheckBox">
            <Setter Property="Background" Value="#FCFCFC"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <!-- Indicador circular estilo switch / radio visual -->
                                <Border x:Name="Indicador" Grid.Column="1" Width="24" Height="24" CornerRadius="12" 
                                        BorderBrush="{StaticResource ColorBorde}" BorderThickness="2" Background="White"
                                        VerticalAlignment="Center" Margin="15,0,5,0">
                                    <Ellipse x:Name="PuntoInterior" Width="12" Height="12" Fill="{StaticResource ColorPrimario}" Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#D4A373"/>
                                <Setter TargetName="Borde" Property="Background" Value="#FFFDF9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#FFF8F3"/>
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                <Setter TargetName="Indicador" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                <Setter TargetName="PuntoInterior" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>