<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Frontend.ViewModels"
        xmlns:views="clr-namespace:Frontend.Views"
        Title="Sistema de Planeación NEM — Plan de Estudios 2022" 
        Height="800" Width="1200" 
        MinHeight="750" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FDF8F2"
        FontFamily="{StaticResource FuenteApp}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource ColorFondo}">
        <Grid.RowDefinitions>
            <!-- Barra Superior de Navegación y Estado -->
            <RowDefinition Height="Auto"/>
            <!-- Banner de Alertas / Notificaciones -->
            <RowDefinition Height="Auto"/>
            <!-- Contenido Principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ENCABEZADO SUPERIOR Y NAVEGACIÓN ENTRE VISTAS                     -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ColorBorde}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Título de la Aplicación -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="🇲🇽" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Planeación Didáctica NEM" FontSize="17" FontWeight="Bold" Foreground="#1E1E1E" FontFamily="Georgia"/>
                        <TextBlock Text="Plan de Estudios 2022 · Educación Primaria" FontSize="11" Foreground="{StaticResource ColorTextoSecundario}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pestañas de Navegación Superior -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="📝 Asistente de Planeación" Command="{Binding IrAVistaWizardCommand}"
                            Background="Transparent" BorderThickness="0" Margin="0,0,6,0" Padding="12,7" Cursor="Hand" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsVistaWizard}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="⚙️ Configuración (Contexto y API)" Command="{Binding IrAVistaConfiguracionCommand}"
                            Background="Transparent" BorderThickness="0" Margin="0,0,6,0" Padding="12,7" Cursor="Hand" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsVistaConfiguracion}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="📂 Mis Planeaciones" Command="{Binding IrAVistaHistorialCommand}"
                            Background="Transparent" BorderThickness="0" Padding="12,7" Cursor="Hand" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsVistaHistorial}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Estado de la API Key en el Header -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfiguracionVM.Estado.ApiKeyConfigurada}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EstadoApiKeyBanner}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- BANNER DE ALERTAS / NOTIFICACIONES INFORMATIVAS                   -->
        <!-- ================================================================= -->
        <StackPanel Grid.Row="1">
            <!-- Alerta si falta configurar API Key -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="25,10"
                    Visibility="{Binding MostrarAlertaApiKey, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="No has configurado tu API Key de Gemini. Necesitas agregarla una vez en Configuración para poder generar planeaciones."
                               FontSize="13" Foreground="#991B1B" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Configurar API Key →" Command="{Binding IrAConfiguracionApiCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#DC2626" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Alerta si falta configurar el perfil de contexto -->
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="25,10"
                    Visibility="{Binding MostrarAlertaPerfil, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📌" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Configura el contexto de tu grupo (grados, número de alumnos, entorno). Se guardará para que no tengas que escribirlo cada vez."
                               FontSize="13" Foreground="#92400E" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Guardar Perfil →" Command="{Binding IrAConfiguracionPerfilCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#D97706" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Mensaje temporal de Notificación Toast -->
            <Border Visibility="{Binding MensajeNotificacion, Converter={StaticResource NullOrEmptyToVis}}"
                    BorderThickness="0,0,0,1" Padding="25,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F0FDF4"/>
                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsNotificacionError}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MensajeNotificacion}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#15803D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsNotificacionError}" Value="True">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Content="✕" Command="{Binding CerrarNotificacionCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" Padding="8,2"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ================================================================= -->
        <!-- CUERPO PRINCIPAL CONDICIONAL SEGÚN LA VISTA ACTIVA                -->
        <!-- ================================================================= -->
        <Grid Grid.Row="2">

            <!-- ============================================================= -->
            <!-- VISTA 0: ASISTENTE DE PLANEACIÓN DIDÁCTICA (WIZARD)           -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding EsVistaWizard, Converter={StaticResource BoolToVis}}" Margin="40,25,40,30">
                <Grid.RowDefinitions>
                    <!-- Indicador de Pasos del Asistente -->
                    <RowDefinition Height="Auto"/>
                    <!-- Contenido del Paso Actual -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- STEPPER / INDICADOR DE PROGRESO INTERACTIVO               -->
                <!-- ========================================================= -->
                <Border Grid.Row="0" Margin="0,5,0,30" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Círculos y líneas -->
                            <RowDefinition Height="Auto"/> <!-- Etiquetas de texto -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/> <!-- Paso 0: Currícula NEM -->
                            <ColumnDefinition Width="135"/> <!-- Paso 1: Planeación -->
                            <ColumnDefinition Width="135"/> <!-- Paso 2: Evaluación -->
                            <ColumnDefinition Width="135"/> <!-- Paso 3: Resumen -->
                        </Grid.ColumnDefinitions>

                        <!-- Líneas conectoras entre círculos (centradas verticalmente a la altura del círculo) -->
                        <!-- Línea entre Paso 0 y Paso 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="2.5" VerticalAlignment="Center" Margin="67.5,0,67.5,0" CornerRadius="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E5D8C5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                            <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Línea entre Paso 1 y Paso 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="2.5" VerticalAlignment="Center" Margin="67.5,0,67.5,0" CornerRadius="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E5D8C5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                            <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Línea entre Paso 2 y Paso 3 -->
                        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Height="2.5" VerticalAlignment="Center" Margin="67.5,0,67.5,0" CornerRadius="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E5D8C5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                            <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- BOTÓN PASO 0: Currícula NEM -->
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                                Command="{Binding IrAPasoCommand}" CommandParameter="0"
                                Style="{StaticResource BotonPasoStepper}" ToolTip="Ir a Currícula NEM">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Círculo -->
                                <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#C25A38" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#4E7D6E" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                    <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#4E7D6E" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#4E7D6E" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="1" FontSize="15" FontWeight="Bold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <!-- Etiqueta -->
                                <TextBlock Text="Currícula NEM" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- BOTÓN PASO 1: Planeación -->
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                                Command="{Binding IrAPasoCommand}" CommandParameter="1"
                                Style="{StaticResource BotonPasoStepper}" ToolTip="Ir a Planeación">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Círculo -->
                                <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFECE6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#C25A38" Opacity="0.35"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                    <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#4E7D6E" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#4E7D6E" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="2" FontSize="15" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8A7B6A"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <!-- Etiqueta -->
                                <TextBlock Text="Planeación" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- BOTÓN PASO 2: Evaluación -->
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" 
                                Command="{Binding IrAPasoCommand}" CommandParameter="2"
                                Style="{StaticResource BotonPasoStepper}" ToolTip="Ir a Evaluación Formativa">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Círculo -->
                                <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFECE6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                    <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#C25A38" Opacity="0.35"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#4E7D6E" Opacity="0.3"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="3" FontSize="15" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8A7B6A"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <!-- Etiqueta -->
                                <TextBlock Text="Evaluación" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorExito}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- BOTÓN PASO 3: Resumen -->
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" 
                                Command="{Binding IrAPasoCommand}" CommandParameter="3"
                                Style="{StaticResource BotonPasoStepper}" ToolTip="Ir a Resumen y Generación">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Círculo -->
                                <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFECE6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#C25A38" Opacity="0.35"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="4" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#8A7B6A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <!-- Etiqueta -->
                                <TextBlock Text="Resumen" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasoActual}" Value="3">
                                                    <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Contenido de los pasos mediante TabControl -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding PasoActual}" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ===================================================== -->
                    <!-- PASO 0: CURRÍCULA NEM                                 -->
                    <!-- ===================================================== -->
                    <TabItem>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                                <StackPanel MaxWidth="920">
                                    <TextBlock Text="📚 Estructura Curricular NEM" FontSize="30" FontWeight="Bold" Foreground="#1E1E1E" Margin="0,0,0,8" FontFamily="Georgia"/>
                                    <TextBlock Text="Selecciona los elementos del Plan de Estudios 2022 que corresponden a esta planeación." FontSize="15" Foreground="#5C5C5C" Margin="0,0,0,25"/>

                                    <!-- Campo Formativo -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="CAMPO FORMATIVO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <UniformGrid Columns="2" Rows="2">
                                                <RadioButton Content="Lenguajes" GroupName="CampoFormativo" Style="{StaticResource ChipToggle}"
                                                             IsChecked="{Binding CampoFormativo, Converter={StaticResource EqToBool}, ConverterParameter=Lenguajes, Mode=TwoWay}"
                                                             HorizontalContentAlignment="Left" Padding="20,14"/>
                                                <RadioButton Content="Saberes y Pensamiento Científico" GroupName="CampoFormativo" Style="{StaticResource ChipToggle}"
                                                             IsChecked="{Binding CampoFormativo, Converter={StaticResource EqToBool}, ConverterParameter='Saberes y Pensamiento Científico', Mode=TwoWay}"
                                                             HorizontalContentAlignment="Left" Padding="20,14"/>
                                                <RadioButton Content="Ética, Naturaleza y Sociedades" GroupName="CampoFormativo" Style="{StaticResource ChipToggle}"
                                                             IsChecked="{Binding CampoFormativo, Converter={StaticResource EqToBool}, ConverterParameter='Ética, Naturaleza y Sociedades', Mode=TwoWay}"
                                                             HorizontalContentAlignment="Left" Padding="20,14"/>
                                                <RadioButton Content="De lo Humano y lo Comunitario" GroupName="CampoFormativo" Style="{StaticResource ChipToggle}"
                                                             IsChecked="{Binding CampoFormativo, Converter={StaticResource EqToBool}, ConverterParameter='De lo Humano y lo Comunitario', Mode=TwoWay}"
                                                             HorizontalContentAlignment="Left" Padding="20,14"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ejes Articuladores -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="EJES ARTICULADORES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <ItemsControl ItemsSource="{Binding EjesArticuladoresOpciones.Opciones}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Content="{Binding Nombre}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ChipToggle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Contenido Curricular y Catálogo Precargado NEM -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="CONTENIDOS DEL PROGRAMA SINTÉTICO NEM 2022 (PRECARGADOS)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}"/>
                                                    <TextBlock Text="{Binding GradosActivosCatalogoTexto}" FontSize="12" Foreground="#4E7D6E" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Cambiar grados ⚙️" Command="{Binding IrAConfiguracionPerfilCommand}"
                                                        Background="#FFF2EB" BorderBrush="#E5D8C5" BorderThickness="1" Foreground="{StaticResource ColorPrimario}"
                                                        FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Buscador rápido del catálogo -->
                                            <TextBox Style="{StaticResource TextBoxElegante}"
                                                     Text="{Binding FiltroCatalogo, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="🔍 Buscar contenido o palabra clave (ej. fracciones, ecosistema, cuentos, salud)..."
                                                     Margin="0,5,0,12"/>

                                            <!-- Lista interactiva de Contenidos precargados -->
                                            <TextBlock Text="Haz clic en un contenido oficial para seleccionarlo y cargar sus PDA automáticamente:"
                                                       FontSize="12.5" Foreground="#64748B" Margin="0,0,0,8"/>

                                            <ListBox ItemsSource="{Binding ContenidosFiltrados}"
                                                     SelectedItem="{Binding ContenidoCatalogoSeleccionado, Mode=TwoWay}"
                                                     MaxHeight="230"
                                                     Background="#FAF7F2"
                                                     BorderBrush="{StaticResource ColorBorde}"
                                                     BorderThickness="1"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Padding="6"
                                                     Margin="0,0,0,18">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="CardItem" Background="White" BorderBrush="#E5D8C5" BorderThickness="1.2" CornerRadius="10" Padding="14,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Background="#FFF2EB" CornerRadius="6" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding FaseTexto}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorPrimario}"/>
                                                                            </Border>
                                                                            <TextBlock x:Name="TxtTitulo" Grid.Column="1" Text="{Binding Titulo}" FontSize="13.5" Foreground="#1E293B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                            <Border x:Name="BadgeCheck" Grid.Column="2" Background="#F1F5F9" CornerRadius="12" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                                <TextBlock x:Name="TxtBadge" Text="{Binding TotalPda, StringFormat='{}{0} PDA'}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardItem" Property="BorderBrush" Value="#D4A373"/>
                                                                            <Setter TargetName="CardItem" Property="Background" Value="#FFFDF9"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="CardItem" Property="Background" Value="#FFF2EB"/>
                                                                            <Setter TargetName="CardItem" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                                                            <Setter TargetName="CardItem" Property="BorderThickness" Value="2"/>
                                                                            <Setter TargetName="TxtTitulo" Property="FontWeight" Value="Bold"/>
                                                                            <Setter TargetName="BadgeCheck" Property="Background" Value="{StaticResource ColorPrimario}"/>
                                                                            <Setter TargetName="TxtBadge" Property="Foreground" Value="White"/>
                                                                            <Setter TargetName="TxtBadge" Property="Text" Value="✓ Seleccionado"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>           </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>

                                            <!-- Contenido seleccionado o personalizado -->
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Contenido Seleccionado (puedes ajustarlo o redactar uno propio)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorTextoPrincipal}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="💾 Guardar en mi catálogo" Command="{Binding GuardarContenidoPersonalizadoCommand}"
                                                        ToolTip="Guarda este contenido y sus PDA en tu catálogo personal para futuras planeaciones"
                                                        Background="Transparent" BorderThickness="0" Foreground="#4E7D6E" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                                            </Grid>
                                            <TextBox Style="{StaticResource TextBoxElegante}" Height="68" TextWrapping="Wrap" Text="{Binding Contenido, UpdateSourceTrigger=PropertyChanged}" Tag="Selecciona un contenido de la lista de arriba o escribe uno personalizado..."/>

                                            <TextBlock Text="Subcontenido o especificidad local (opcional)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorTextoPrincipal}" Margin="0,0,0,5"/>
                                            <TextBox Style="{StaticResource TextBoxElegante}" Text="{Binding Subcontenido, UpdateSourceTrigger=PropertyChanged}" Tag="Ej. El ciclo del agua y el cuidado comunitario en nuestra localidad"/>

                                            <TextBlock Text="Intención Didáctica (opcional)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorTextoPrincipal}" Margin="0,0,0,5"/>
                                            <TextBox Style="{StaticResource TextBoxElegante}" Height="68" TextWrapping="Wrap" Text="{Binding Intencion, UpdateSourceTrigger=PropertyChanged}" Tag="¿Qué deseas que los alumnos logren reflexionar, aprender o transformar?" Margin="0,5,0,5"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PDA (Procesos de Desarrollo de Aprendizaje) -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="PROCESOS DE DESARROLLO DE APRENDIZAJE (PDA)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}"/>
                                                    <TextBlock Text="Marca o desmarca los PDA sugeridos del contenido elegido, o agrega PDA propios." FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Seleccionar todos" Command="{Binding SeleccionarTodosPdaCommand}"
                                                            Visibility="{Binding TienePdaSugeridosCatalogo, Converter={StaticResource BoolToVis}}"
                                                            Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" Foreground="#15803D"
                                                            FontSize="12" FontWeight="SemiBold" Padding="10,5" Margin="0,0,8,0" Cursor="Hand"/>
                                                    <Button Content="Limpiar lista" Command="{Binding LimpiarPdaCommand}"
                                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Foreground="#DC2626"
                                                            FontSize="12" FontWeight="SemiBold" Padding="10,5" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Tarjetas de PDA precargados del contenido elegido -->
                                            <Border Background="#FAF7F2" BorderBrush="#E5D8C5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16"
                                                    Visibility="{Binding TienePdaSugeridosCatalogo, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="✨ PDA oficiales del contenido seleccionado (haz clic para activar o desactivar):"
                                                               FontSize="12.5" FontWeight="Bold" Foreground="#4E7D6E" Margin="0,0,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding PdaSugeridosCatalogo}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay}" Cursor="Hand" Margin="0,0,0,8">
                                                                    <CheckBox.Template>
                                                                        <ControlTemplate TargetType="CheckBox">
                                                                            <Border x:Name="PdaBox" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="8" Padding="12,9">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Border x:Name="CheckIcon" Grid.Column="0" Width="20" Height="20" CornerRadius="5" BorderBrush="#CBD5E1" BorderThickness="1.5" Background="White" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                        <TextBlock x:Name="CheckMark" Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                                                    </Border>
                                                                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Grado}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                                                                    </Border>
                                                                                    <TextBlock Grid.Column="2" Text="{Binding Texto}" FontSize="13" Foreground="#1E293B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="PdaBox" Property="BorderBrush" Value="#D4A373"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="PdaBox" Property="Background" Value="#FFF5EE"/>
                                                                                    <Setter TargetName="PdaBox" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                                                                    <Setter TargetName="CheckIcon" Property="Background" Value="{StaticResource ColorPrimario}"/>
                                                                                    <Setter TargetName="CheckIcon" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </CheckBox.Template>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Captura manual para agregar un PDA adicional -->
                                            <TextBlock Text="Agregar un PDA adicional o personalizado:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource ColorTextoPrincipal}" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="15"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Style="{StaticResource TextBoxElegante}" Text="{Binding PdaLista.Nuevo, UpdateSourceTrigger=PropertyChanged}" Tag="Escribe un PDA personalizado y haz clic en Agregar..." Margin="0"/>
                                                <Button Grid.Column="2" Content="+ Agregar PDA" Command="{Binding PdaLista.AgregarCommand}" Style="{StaticResource BotonNaranja}" Height="45" Padding="20,0"/>
                                            </Grid>

                                            <!-- Lista de PDAs seleccionados que se enviarán a la planeación -->
                                            <TextBlock Text="PDA incluidos en esta planeación:" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding PdaLista.Elementos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="•" FontWeight="Bold" Foreground="{StaticResource ColorPrimario}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                                                <Button Grid.Column="2" Content="✕" 
                                                                        Command="{Binding DataContext.PdaLista.QuitarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontWeight="Bold" Cursor="Hand" Padding="8,2"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Botón Siguiente -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,20">
                                        <Button Content="Continuar a Diseño →" Command="{Binding ContinuarCommand}" Style="{StaticResource BotonNaranja}" Padding="25,14" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ===================================================== -->
                    <!-- PASO 1: DISEÑO DE LA PLANEACIÓN                       -->
                    <!-- ===================================================== -->
                    <TabItem>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                                <StackPanel MaxWidth="920">
                                    <TextBlock Text="✏️ Diseño de la Planeación" FontSize="30" FontWeight="Bold" Foreground="#1E1E1E" Margin="0,0,0,8" FontFamily="Georgia"/>
                                    <TextBlock Text="Define el tema central, la metodología sociocrítica y los tiempos de la secuencia." FontSize="15" Foreground="#5C5C5C" Margin="0,0,0,25"/>

                                    <!-- Tema de Interés -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="TEMA DE INTERÉS O PROYECTO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <TextBlock Text="¿Cuál es el problema o tema detonador?" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorTextoPrincipal}" Margin="0,0,0,5"/>
                                            <TextBox Style="{StaticResource TextBoxElegante}" Height="70" TextWrapping="Wrap" Text="{Binding TemaInteres, UpdateSourceTrigger=PropertyChanged}" 
                                                     Tag="Ej. El cuidado del agua en nuestra colonia, Leyendas tradicionales de la comunidad..." Margin="0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metodología Didáctica -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="METODOLOGÍA DIDÁCTICA SOCIOCRÍTICA" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <UniformGrid Columns="2" Rows="2">
                                                <RadioButton GroupName="MetodologiaGroup" Style="{StaticResource TarjetaMetodologia}"
                                                             IsChecked="{Binding Metodologia, Converter={StaticResource EqToBool}, ConverterParameter=STEAM, Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🔬" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="STEAM" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="Ciencia, Tecnología, Ingeniería, Arte y Matemáticas integradas." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton GroupName="MetodologiaGroup" Style="{StaticResource TarjetaMetodologia}"
                                                             IsChecked="{Binding Metodologia, Converter={StaticResource EqToBool}, ConverterParameter='Aprendizaje Basado en Problemas', Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🧩" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Aprendizaje Basado en Problemas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="Los estudiantes resuelven un problema real o simulado." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton GroupName="MetodologiaGroup" Style="{StaticResource TarjetaMetodologia}"
                                                             IsChecked="{Binding Metodologia, Converter={StaticResource EqToBool}, ConverterParameter='Proyectos Comunitarios', Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🏡" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Proyectos Comunitarios" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="La comunidad es el punto de partida y de llegada del aprendizaje." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton GroupName="MetodologiaGroup" Style="{StaticResource TarjetaMetodologia}"
                                                             IsChecked="{Binding Metodologia, Converter={StaticResource EqToBool}, ConverterParameter=Aprendizaje-Servicio, Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🤝" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Aprendizaje-Servicio" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="Los estudiantes aprenden mientras sirven a su comunidad." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tiempos -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="ORGANIZACIÓN DEL TIEMPO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Duración total (días / sesiones)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorTextoPrincipal}" Margin="0,0,0,5"/>
                                                    <TextBox Style="{StaticResource TextBoxElegante}" Text="{Binding DuracionDias, UpdateSourceTrigger=PropertyChanged}" Tag="Ej. 5" Margin="0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Duración por sesión (minutos)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorTextoPrincipal}" Margin="0,0,0,5"/>
                                                    <TextBox Style="{StaticResource TextBoxElegante}" Text="{Binding DuracionMinutos, UpdateSourceTrigger=PropertyChanged}" Tag="Ej. 50" Margin="0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Navegación -->
                                    <Grid Margin="0,15,0,20">
                                        <Button Content="← Atrás" Command="{Binding AtrasCommand}" Background="Transparent" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" FontSize="14"/>
                                        <Button Content="Continuar a Evaluación →" Command="{Binding ContinuarCommand}" Style="{StaticResource BotonNaranja}" Padding="25,14" HorizontalAlignment="Right" FontSize="14"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ===================================================== -->
                    <!-- PASO 2: EVALUACIÓN FORMATIVA                          -->
                    <!-- ===================================================== -->
                    <TabItem>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                                <StackPanel MaxWidth="920">
                                    <TextBlock Text="📋 Plan de Evaluación Formativa" FontSize="30" FontWeight="Bold" Foreground="#1E1E1E" Margin="0,0,0,8" FontFamily="Georgia"/>
                                    <TextBlock Text="Determina el instrumento, criterios clave y materiales a generar." FontSize="15" Foreground="#5C5C5C" Margin="0,0,0,25"/>

                                    <!-- Instrumento -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="INSTRUMENTO DE EVALUACIÓN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <StackPanel>
                                                <RadioButton GroupName="InstGroup" Style="{StaticResource TarjetaInstrumento}"
                                                             IsChecked="{Binding Instrumento, Converter={StaticResource EqToBool}, ConverterParameter='Lista de Cotejo', Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#F5EEFD" BorderBrush="#E9D5FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="☑️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Lista de Cotejo" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="Registra la presencia o ausencia de criterios específicos." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>

                                                <RadioButton GroupName="InstGroup" Style="{StaticResource TarjetaInstrumento}"
                                                             IsChecked="{Binding Instrumento, Converter={StaticResource EqToBool}, ConverterParameter=Rúbrica, Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Rúbrica" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="Describe niveles de desempeño para cada criterio." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>

                                                <RadioButton GroupName="InstGroup" Style="{StaticResource TarjetaInstrumento}"
                                                             IsChecked="{Binding Instrumento, Converter={StaticResource EqToBool}, ConverterParameter='Guía de Observación', Mode=TwoWay}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Guía de Observación" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                            <TextBlock Text="Guía estructurada para observar actitudes y habilidades." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </RadioButton>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Criterios -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="CRITERIOS ESPECÍFICOS DE EVALUACIÓN (OPCIONAL)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="15"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Style="{StaticResource TextBoxElegante}" Text="{Binding CriteriosLista.Nuevo, UpdateSourceTrigger=PropertyChanged}" Tag="Ej. Participa activamente y colabora con sus pares..." Margin="0"/>
                                                <Button Grid.Column="2" Content="Agregar Criterio" Command="{Binding CriteriosLista.AgregarCommand}" Style="{StaticResource BotonNaranja}" Height="45" Padding="20,0"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding CriteriosLista.Elementos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="13" Foreground="#334155"/>
                                                                <Button Grid.Column="1" Content="✕" 
                                                                        Command="{Binding DataContext.CriteriosLista.QuitarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontWeight="Bold" Cursor="Hand" Padding="8,2"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Materiales -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel>
                                            <TextBlock Text="MATERIALES A GENERAR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,15"/>
                                            <CheckBox IsChecked="{Binding GenerarFicha}" Style="{StaticResource TarjetaMaterial}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#EDE9FE" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Ficha de Contenido" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                        <TextBlock Text="Resumen con los conceptos clave del tema." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </CheckBox>

                                            <CheckBox IsChecked="{Binding GenerarEditable}" Style="{StaticResource TarjetaMaterial}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#FEF3C7" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Formato Editable (Word / Google Docs)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
                                                        <TextBlock Text="Documento estructurado listo para abrir en Google Docs o descargar en Word (.docx)." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Navegación -->
                                    <Grid Margin="0,15,0,20">
                                        <Button Content="← Atrás" Command="{Binding AtrasCommand}" Background="Transparent" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" FontSize="14"/>
                                        <Button Content="Revisar y Generar con IA →" Command="{Binding ContinuarCommand}" Style="{StaticResource BotonNaranja}" Padding="25,14" HorizontalAlignment="Right" FontSize="14"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ===================================================== -->
                    <!-- PASO 3: RESUMEN Y GENERACIÓN CON IA                   -->
                    <!-- ===================================================== -->
                    <TabItem>
                        <Grid>
                            <ScrollViewer x:Name="ScrollPaso3" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                                <StackPanel MaxWidth="920">
                                    <TextBlock Text="🚀 Generación y Exportación (Word y Google Docs)" FontSize="30" FontWeight="Bold" Foreground="#1E1E1E" Margin="0,0,0,8" FontFamily="Georgia"/>
                                    <TextBlock Text="Revisa el resumen de tu planeación, genérala con Gemini y ábrela en Google Docs o Word." FontSize="15" Foreground="#5C5C5C" Margin="0,0,0,25"/>

                                    <!-- Banner Resumen de Configuración del Aula y Selección Curricular -->
                                    <Border Background="#FAF7F2" BorderBrush="#E5D8C5" BorderThickness="1.2" CornerRadius="14" Padding="22,18" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                <!-- Título y Estado del Contexto -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="📌 Contexto del Grupo para esta Planeación:" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorPrimario}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    
                                                    <!-- Badge Perfil Completo -->
                                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="9,3"
                                                            Visibility="{Binding PerfilEstaCompleto, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                        <TextBlock Text="✓ Contexto activo" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                                    </Border>
                                                    
                                                    <!-- Badge Perfil Incompleto -->
                                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="9,3"
                                                            Visibility="{Binding PerfilIncompleto, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                        <TextBlock Text="⚠️ Contexto incompleto" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Fila de Fichas/Chips del Contexto -->
                                                <WrapPanel Margin="0,0,0,10">
                                                    <!-- Alumnos -->
                                                    <Border Background="White" BorderBrush="#E5D8C5" BorderThickness="1.2" CornerRadius="8" Padding="12,7" Margin="0,0,10,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👥 Alumnos: " FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding AlumnosPerfilResumenTexto}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Entorno -->
                                                    <Border Background="White" BorderBrush="#E5D8C5" BorderThickness="1.2" CornerRadius="8" Padding="12,7" Margin="0,0,10,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🏫 Entorno: " FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding EntornoPerfilResumenTexto}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Grados -->
                                                    <Border Background="White" BorderBrush="#E5D8C5" BorderThickness="1.2" CornerRadius="8" Padding="12,7" Margin="0,0,10,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🎒 Grados: " FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding GradosPerfilResumenTexto}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Docente / Escuela si existe -->
                                                    <Border Background="White" BorderBrush="#E5D8C5" BorderThickness="1.2" CornerRadius="8" Padding="12,7" Margin="0,0,10,8"
                                                            Visibility="{Binding TieneDocenteOEscuela, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👩‍🏫 " FontSize="13" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DocenteEscuelaResumenTexto}" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Elementos Curriculares Seleccionados -->
                                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CampoFormativo, StringFormat='📚 Campo: {0}'}" FontSize="13" FontWeight="Bold" Foreground="#4E7D6E" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding Contenido, StringFormat='📖 Contenido: {0}'}" FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ResumenPdasSeleccionadosTexto}" FontSize="12.5" FontWeight="SemiBold" Foreground="#C25A38" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Botón Modificar Contexto -->
                                            <Button Grid.Column="1" Content="Modificar Contexto ✏️" Command="{Binding IrAConfiguracionPerfilCommand}"
                                                    ToolTip="Edita los grados, número de alumnos o entorno en tu perfil guardado"
                                                    Background="White" BorderBrush="#E5D8C5" BorderThickness="1.5" Padding="16,10" Foreground="{StaticResource ColorPrimario}" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Botón Principal Generar Planeación -->
                                    <Border Style="{StaticResource TarjetaFigma}">
                                        <StackPanel HorizontalAlignment="Center" Margin="15">
                                            <TextBlock Text="✨ Generar Planeación Didáctica con IA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Gemini diseñará la secuencia didáctica completa considerando las fases de la metodología, los PDA seleccionados y las adecuaciones para tu grupo."
                                                       FontSize="14" Foreground="{StaticResource ColorTextoSecundario}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                            
                                            <Button Content="¡Generar Planeación con Gemini! 🚀" 
                                                    Command="{Binding GenerarPlaneacionCommand}"
                                                    Style="{StaticResource BotonNaranja}" 
                                                    Padding="35,16" FontSize="16"
                                                    HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Resultado Generado y Opciones de Exportación (Word + Google Docs) -->
                                    <StackPanel x:Name="SeccionResultadoPlaneacion" Visibility="{Binding TienePlaneacionGenerada, Converter={StaticResource BoolToVis}}" Margin="0,10,0,30">
                                        <!-- Banner Recordatorio de Desplazamiento hacia Abajo -->
                                        <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1.5" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⬇️" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="¡Tu planeación didáctica está lista aquí abajo!" FontSize="15" FontWeight="Bold" Foreground="#065F46"/>
                                                    <TextBlock Text="Desplázate hacia abajo con la rueda del ratón o la barra lateral para leer toda la secuencia didáctica, o usa los botones de abajo para abrirla directamente en Google Docs o Word."
                                                               FontSize="13" Foreground="#047857" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource TarjetaFigma}" Background="#FFFDF9" BorderBrush="#D4A373" Padding="22,18" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PlaneacionActual.Titulo}" FontSize="21" FontWeight="Bold" Foreground="#1E1E1E" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBlock Text="Elige cómo deseas trabajar o exportar tu planeación didáctica:" FontSize="13" Foreground="#64748B" Margin="0,0,0,14"/>

                                                <WrapPanel>
                                                    <Button Content="🌐 Abrir e Insertar en Google Docs (Automático)" 
                                                            Command="{Binding AbrirEnGoogleDocsCommand}" 
                                                            Style="{StaticResource BotonGoogleDocs}" 
                                                            ToolTip="Abre Google Docs e inserta automáticamente tu planeación con tablas y colores (sin necesidad de usar el teclado)"
                                                            Padding="20,12" Margin="0,0,12,8"/>

                                                    <Button Content="📄 Descargar en Word (.docx)" 
                                                            Command="{Binding DescargarWordCommand}" 
                                                            Style="{StaticResource BotonNaranja}" 
                                                            ToolTip="Genera y abre el archivo .docx compatible con Microsoft Word, LibreOffice o Google Drive"
                                                            Padding="20,12" Margin="0,0,12,8"/>

                                                    <Button Content="📋 Copiar con formato" 
                                                            Command="{Binding CopiarPlaneacionCommand}" 
                                                            Style="{StaticResource BotonGris}" 
                                                            ToolTip="Copia la planeación con tablas y formato enriquecido al portapapeles"
                                                            Padding="18,12" Margin="0,0,0,8"/>
                                                </WrapPanel>

                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                                                    <TextBlock Text="✨ Pegado Automático en Google Docs: Al hacer clic en «Abrir e Insertar en Google Docs», el sistema abrirá una hoja nueva y escribirá tu planeación sola en cuanto cargue la página (además aparecerá un botón naranja flotante en la esquina por si tu internet tarda y deseas insertarla con 1 clic)."
                                                               FontSize="12.5" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Visor de contenido Markdown / Texto -->
                                        <Border Style="{StaticResource TarjetaFigma}" Background="#FFFFFF">
                                            <TextBox Text="{Binding TextoResultadoMarkdown, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     FontSize="14" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True" Foreground="#1E293B"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Botón Atrás -->
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,20">
                                        <Button Content="← Volver a Evaluación" Command="{Binding AtrasCommand}" Background="Transparent" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>

            <!-- ============================================================= -->
            <!-- VISTA 1: MENÚ DE CONFIGURACIÓN (CONTEXTO Y API KEY)           -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding EsVistaConfiguracion, Converter={StaticResource BoolToVis}}">
                <views:ConfiguracionView DataContext="{Binding ConfiguracionVM}"/>
            </Grid>

            <!-- ============================================================= -->
            <!-- VISTA 2: HISTORIAL DE PLANEACIONES                            -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding EsVistaHistorial, Converter={StaticResource BoolToVis}}">
                <views:HistorialView/>
            </Grid>

            <!-- ============================================================= -->
            <!-- MODAL CENTRADO DE CARGA DURANTE LA GENERACIÓN DE PLANEACIÓN   -->
            <!-- ============================================================= -->
            <Grid Visibility="{Binding GenerandoPlaneacion, Converter={StaticResource BoolToVis}}"
                  Background="#A61E293B" Panel.ZIndex="100">
                <Border Background="#FFFDF9" BorderBrush="#D4A373" BorderThickness="2" CornerRadius="18"
                        Padding="36,30" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="8" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Icono superior -->
                        <Border Background="#FFF2EB" BorderBrush="#F5D0BA" BorderThickness="1.5" CornerRadius="40"
                                Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Diseñando tu Planeación Didáctica NEM..."
                                   FontSize="21" FontWeight="Bold" Foreground="#1E1E1E" FontFamily="Georgia"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding EtapaGeneracionTexto}"
                                   FontSize="14.5" FontWeight="SemiBold" Foreground="#C25A38"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Barra de progreso indeterminada -->
                        <ProgressBar IsIndeterminate="True" Height="10" Width="380"
                                     Foreground="#C25A38" Background="#F1E9DC" BorderThickness="0"
                                     Margin="0,0,0,16"/>

                        <!-- Contador y tiempo estimado -->
                        <Border Background="#FAF7F2" BorderBrush="#E5D8C5" BorderThickness="1" CornerRadius="10"
                                Padding="16,10" Margin="0,0,0,14">
                            <TextBlock Text="{Binding TiempoTranscurridoGeneracionTexto}"
                                       FontSize="13.5" FontWeight="Bold" Foreground="#334155"
                                       TextAlignment="Center"/>
                        </Border>

                        <!-- Recordatorio anticipado de bajar -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8"
                                Padding="14,10">
                            <TextBlock Text="💡 Por favor no cierres la ventana. Al terminar, recuerda desplazarte hacia abajo para ver tu planeación completa y exportarla a Google Docs o Word."
                                       FontSize="12.5" Foreground="#065F46" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>